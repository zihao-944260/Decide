{
  "name": "decide",
  "version": "0.1.0",
  "private": true,
  "description": "计划公示与群体表决小程序（uni-app + TS + Skyline + 微信云开发）",
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:cloud": "node scripts/build-cloud.mjs",
    "check:templates": "node scripts/check-templates.mjs",
    "check:docrefs": "node scripts/check-docrefs.mjs",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "commit": "npx git-cz"
  },
  "lint-staged": {
    "*.{vue,ts,js,json,css,scss}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030420261029002",
    "@dcloudio/uni-components": "3.0.0-5030420261029002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5030420261029002",
    "mp-html": "^2.5.2",
    "pinia": "2.1.7",
    "vue": "3.4.21",
    "vue-i18n": "9.13.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-automator": "3.0.0-5030420261029002",
    "@dcloudio/uni-cli-shared": "3.0.0-5030420261029002",
    "@dcloudio/uni-stacktracey": "3.0.0-5030420261029002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030420261029002",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vue/runtime-core": "3.4.21",
    "@vue/tsconfig": "0.5.1",
    "cz-cli": "^1.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "miniprogram-api-typings": "^3.12.2",
    "miniprogram-automator": "^0.13.0",
    "prettier": "^3.10.1",
    "sass": "1.77.8",
    "typescript": "5.4.5",
    "vite": "5.2.8",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "2.0.19"
  }
}
